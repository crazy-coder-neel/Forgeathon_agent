# ==============================================================================
# Environment Configuration Template
# Copy this file to .env or .env.local (do NOT commit your real .env file)
# ==============================================================================

# TrueForge server base URL (default for local mode)
TRUEFORGE_BASE_URL=http://localhost:8790

# Primary model API key (e.g., Google Gemini)
GEMINI_API_KEY=your-api-key

# Optional fallback model API key (if using a remote secondary model)
# FALLBACK_API_KEY=your-api-key

# Pinned Flask workspace directory for tests (defaults to ../flask if adjacent)
# FLASK_DIR=/absolute/path/to/flask

# Enable end-to-end integration tests (requires running TrueForge instance)
# E2E=0
