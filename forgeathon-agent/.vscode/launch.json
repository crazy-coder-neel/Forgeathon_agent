{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension (opens ../flask next to this repo)",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}", "${workspaceFolder}/../flask"],
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "preLaunchTask": "npm: build"
    },
    {
      "name": "Run Extension (choose the Flask folder)",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}", "${input:flaskPath}"],
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "preLaunchTask": "npm: build"
    }
  ],
  "inputs": [
    { "id": "flaskPath", "type": "promptString", "description": "ABSOLUTE path of the cloned pallets/flask (tag 3.1.3) folder", "default": "/absolute/path/to/flask" }
  ]
}
